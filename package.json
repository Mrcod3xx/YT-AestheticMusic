{
  "name": "aesthetic-music-extension",
  "version": "0.3.0",
  "private": true,
  "description": "Transform YouTube Music into an immersive, cinematic macOS-style desktop music player.",
  "type": "module",
  "scripts": {
    "build": "node scripts/bump-version.mjs --check && tsc --noEmit && vite build && vite build --config vite.content.config.ts && vite build --config vite.bridge.config.ts",
    "dev": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "node scripts/bump-version.mjs --check",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0"
  }
}
